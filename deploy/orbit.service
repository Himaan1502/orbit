# ORBIT stack — starts the compose project on boot, stops it on shutdown.
# Install: /etc/systemd/system/orbit.service  →  systemctl enable --now orbit
# ADR-035 §4.

[Unit]
Description=ORBIT (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/orbit
Environment=COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --no-build --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
