# ORBIT production .env — TEMPLATE. ADR-035 §8.
#
# On the VM this lives at /opt/orbit/.env, owned by the deploy user, chmod 600.
# It is NEVER committed and NEVER passed to CI. Fill every <PLACEHOLDER>.
#
# Generate the fresh secrets with, e.g.:
#   openssl rand -base64 36 | tr -d '\n/+=' | head -c 44
#
# ─────────────────────────────────────────────────────────────────────────────
# THE ONE SECRET YOU MUST COPY, NOT GENERATE
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_KEYSTORE_SECRET must be byte-for-byte identical to the value in your
# LOCAL .env. It is the PBKDF2 input that AES-256-GCM-unseals the RSA signing
# key stored in the auth.signing_keys row that comes across in the pg_dump
# (ADR-011 §3). If it differs by one character the auth server starts but
# cannot decrypt its own signing key — no tokens can be issued.
AUTH_KEYSTORE_SECRET=<PASTE EXACTLY FROM LOCAL .env>

# ─────────────────────────────────────────────────────────────────────────────
# Freshly generated strong values for the VM (do NOT reuse local dev values)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<fresh-strong-random>
REDIS_PASSWORD=<fresh-strong-random>
WEB_CLIENT_SECRET=<fresh-strong-random>
SESSION_SECRET=<fresh-strong-random-min-32-chars>

# ─────────────────────────────────────────────────────────────────────────────
# Database identity — keep these matching the dump (defaults are fine)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=orbit_db
POSTGRES_USER=orbit_user

# ─────────────────────────────────────────────────────────────────────────────
# Public URLs — <VM-IP> is the reserved public IP with dots, e.g. 132.145.10.20
# ─────────────────────────────────────────────────────────────────────────────
ORBIT_DOMAIN=<VM-IP>.nip.io
ACME_EMAIL=himaanshu15028@gmail.com

OIDC_ISSUER_URI=https://auth.<VM-IP>.nip.io
OIDC_INTERNAL_ISSUER_URI=http://orbit-auth:9000
WEB_REDIRECT_URI=https://web.<VM-IP>.nip.io/auth/callback
WEB_POST_LOGOUT_URI=https://web.<VM-IP>.nip.io
WEB_PUBLIC_URL=https://web.<VM-IP>.nip.io
CORS_ORIGINS=https://web.<VM-IP>.nip.io

# ─────────────────────────────────────────────────────────────────────────────
# Image tag to run. `latest` = whatever CI last pushed from main; pin to a
# short SHA (e.g. ORBIT_IMAGE_TAG=a1b2c3d) for a controlled deploy / rollback.
# ─────────────────────────────────────────────────────────────────────────────
ORBIT_IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# Nightly backup target (deploy/backup.sh). Bucket + namespace only — auth is
# the VM's instance principal, so there are NO OCI credentials in this file.
# ─────────────────────────────────────────────────────────────────────────────
ORBIT_BACKUP_BUCKET=orbit-db-backups
ORBIT_BACKUP_NAMESPACE=<your-object-storage-namespace>

# ─────────────────────────────────────────────────────────────────────────────
# OSCAR / AI providers (ADR-031). Optional — unset => OSCAR shows the
# unavailable panel and the rest of ORBIT is unaffected. Free-tier, no card.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<paste, or leave blank>
GROQ_API_KEY=<paste, or leave blank>
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b
