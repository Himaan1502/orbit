# ORBIT web (Next.js BFF) — see ADR-013. Copy to .env.local for local dev.
# Everything except NEXT_PUBLIC_* is server-only and must never be exposed.

# Public app name (safe to expose)
NEXT_PUBLIC_APP_NAME=ORBIT
# Optional: override the same-origin BFF proxy base. Leave unset in normal use.
# NEXT_PUBLIC_API_BASE_URL=/api/orbit

# --- OIDC / BFF (server-only) ---
# Issuer as the browser reaches it (redirects target this).
OIDC_ISSUER_URI=http://localhost:9000
# Issuer as the Next server reaches it (token/jwks calls). Same in docker-compose.
OIDC_INTERNAL_ISSUER_URI=http://localhost:9000
WEB_CLIENT_ID=orbit-web
# Confidential client secret — must match apps/auth WEB_CLIENT_SECRET. Not committed.
WEB_CLIENT_SECRET=orbit-local-dev-web-client-secret-change-me
WEB_REDIRECT_URI=http://localhost:3000/auth/callback
WEB_POST_LOGOUT_URI=http://localhost:3000
# apps/api base, reached only server-to-server from the BFF proxy.
API_BASE_URL=http://localhost:8080
# 32+ char high-entropy string; encrypts the session cookie (AES-256-GCM). Not committed.
SESSION_SECRET=orbit-local-dev-session-secret-change-me-please
# Secure cookie flag: auto (https-only) unless forced. Local http => leave unset/false.
WEB_SECURE_COOKIES=false
