SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orbit_db
DB_USERNAME=orbit_user
DB_PASSWORD=orbit_pass
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass
# OAuth2 resource server (tokens issued by apps/auth — see ADR-004).
# dev/default: JWKS URL (signature validation only). prod: set OIDC_ISSUER_URI.
OIDC_JWK_SET_URI=http://localhost:9000/oauth2/jwks
OIDC_ISSUER_URI=http://localhost:9000
CORS_ORIGINS=http://localhost:3000
