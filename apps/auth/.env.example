SPRING_PROFILES_ACTIVE=dev
AUTH_SERVER_PORT=9000

# OIDC issuer identifier — must be reachable under this exact URL from the
# browser and from every resource server (apps/api). See ADR-004.
OIDC_ISSUER_URI=http://localhost:9000

# Registered public client (the Next.js frontend)
WEB_CLIENT_ID=orbit-web
WEB_REDIRECT_URI=http://localhost:3000/auth/callback
WEB_POST_LOGOUT_URI=http://localhost:3000

# Dev login. Leave AUTH_DEV_PASSWORD blank to generate + log one on startup.
AUTH_DEV_USER=dev@orbit.local
AUTH_DEV_PASSWORD=
