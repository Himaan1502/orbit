<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude Lombok-generated code -->
    <Match>
        <Source name="~.*\.java"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Source name="~.*\.java"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Exclude Spring configuration classes -->
    <Match>
        <Class name="~com\.orbit\.auth\.config\..*"/>
    </Match>
</FindBugsFilter>
