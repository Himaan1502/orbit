# ORBIT Environment Configuration
# Copy this file to .env and update values as needed. docker-compose reads it.

# PostgreSQL
POSTGRES_DB=orbit_db
POSTGRES_USER=orbit_user
POSTGRES_PASSWORD=orbit_pass

# Redis
REDIS_PASSWORD=redis_pass

# --- Authentication: self-hosted OIDC provider (apps/auth) — ADR-004, ADR-011..013 ---
OIDC_ISSUER_URI=http://localhost:9000
OIDC_JWK_SET_URI=http://localhost:9000/oauth2/jwks
WEB_REDIRECT_URI=http://localhost:3000/auth/callback
WEB_POST_LOGOUT_URI=http://localhost:3000

# Confidential OAuth client shared by apps/auth (validates) and apps/web BFF (sends).
# CHANGE THIS in any non-local environment.
WEB_CLIENT_SECRET=orbit-local-dev-web-client-secret-change-me

# Seals the auth server's signing-key private material at rest (AES-256-GCM).
# CHANGE THIS; losing it invalidates all issued tokens.
AUTH_KEYSTORE_SECRET=orbit-local-dev-keystore-secret-change-me

# Encrypts the web BFF session cookie (AES-256-GCM). CHANGE THIS.
SESSION_SECRET=orbit-local-dev-session-secret-change-me-please

# Stable local login for apps/auth. Leave blank to skip the dev-user seed and
# register via /signup instead.
AUTH_DEV_USER=dev@orbit.local
AUTH_DEV_PASSWORD=

# Spring
SPRING_PROFILES_ACTIVE=dev

# CORS (apps/api). The browser never calls apps/api directly under the BFF model,
# but this stays permissive for local tooling / curl.
CORS_ORIGINS=http://localhost:3000

# --- OSCAR / AI providers (apps/api) — ADR-031 ---
# Both optional and free-tier (no card). Leave BOTH blank and OSCAR shows the
# "temporarily unavailable" state while the rest of ORBIT works normally.
# Gemini is primary (large context window); Groq is the documented fallback.
#   Gemini key: https://aistudio.google.com/apikey
#   Groq key:   https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# Model IDs move over time — override without a rebuild if the defaults 404.
# Defaults: GEMINI_MODEL=gemini-3.6-flash  GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=
# GROQ_MODEL=
