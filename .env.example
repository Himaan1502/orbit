# ORBIT Environment Configuration
# Copy this file to .env and update values as needed

# PostgreSQL
POSTGRES_DB=orbit_db
POSTGRES_USER=orbit_user
POSTGRES_PASSWORD=orbit_pass

# Redis
REDIS_PASSWORD=redis_pass

# Authentication — self-hosted OIDC provider (apps/auth, Spring Authorization
# Server). See ADR-004. No shared signing secret: the API validates RS256
# tokens against the provider JWKS.
OIDC_ISSUER_URI=http://localhost:9000
OIDC_JWK_SET_URI=http://localhost:9000/oauth2/jwks
WEB_REDIRECT_URI=http://localhost:3000/auth/callback
WEB_POST_LOGOUT_URI=http://localhost:3000
AUTH_DEV_USER=dev@orbit.local
# AUTH_DEV_PASSWORD: leave unset to have the auth server generate + log one on
# startup; set it here for a stable local login.
AUTH_DEV_PASSWORD=

# Spring
SPRING_PROFILES_ACTIVE=dev

# CORS
CORS_ORIGINS=http://localhost:3000
