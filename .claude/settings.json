{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npx *)",
      "Bash(./gradlew *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(git *)",
      "Bash(curl http://localhost:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },
  "includeCoAuthoredBy": false
}